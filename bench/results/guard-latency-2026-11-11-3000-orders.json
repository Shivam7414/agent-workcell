    "paid per invoice, failed payments excluded": "SELECT i.document_number, sum(a.amount) FROM supplier_invoices i JOIN payment_allocations a ON a.supplier_invoice_id = i.id JOIN payments p ON p.id = a.payment_id AND p.status <> 'failed' GROUP BY i.document_number",
    "one order by number": "SELECT * FROM purchase_orders WHERE po_number = '4500000001'"

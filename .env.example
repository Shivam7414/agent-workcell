# Copy to .env. Docker Compose reads it. These values are for local development only.

# Password of the reference ERP's owner account in the local PostgreSQL container.
ERP_OWNER_PASSWORD=erp_owner_dev

# Port on this computer for the local PostgreSQL container.
ERP_DB_PORT=54329

# For running the seed and the tests from your own Python, outside Docker.
ERP_DATABASE_URL=postgresql://erp_owner:erp_owner_dev@127.0.0.1:54329/erp
ERP_TEST_DATABASE_URL=postgresql://erp_owner:erp_owner_dev@127.0.0.1:54329/erp_test

# The data guard and the knowledge graph (python -m agent_workcell.guard, python -m agent_workcell.knowledge): the
# policy file, the knowledge directory, and the passwords that "guard apply" gives the agent and binder roles.
# Local development only; in production an administrator sets them.
WORKCELL_POLICY=reference_erp/policy.toml
WORKCELL_KNOWLEDGE=reference_erp/knowledge
WORKCELL_AGENT_PASSWORD=workcell_agent_dev
WORKCELL_BINDER_PASSWORD=workcell_binder_dev
# The password that "documents apply" gives the documents role (python -m agent_workcell.documents).
WORKCELL_DOCUMENTS_PASSWORD=workcell_documents_dev

# The answer server (python -m agent_workcell.server). The host application calls it with WORKCELL_HOST_KEY.
WORKCELL_AGENT_DATABASE_URL=postgresql://workcell_agent:workcell_agent_dev@127.0.0.1:54329/erp
WORKCELL_BINDER_DATABASE_URL=postgresql://workcell_binder:workcell_binder_dev@127.0.0.1:54329/erp
WORKCELL_HOST_KEY=change-me-to-a-long-random-secret-for-local-use
# Audit, memory, files and per-run folders. The runtime runs here, so it must be outside this repository.
WORKCELL_DATA_DIR=~/.agent-workcell
# The reference ERP's data is fixed at this date. Leave it out for a real system.
WORKCELL_TODAY=2026-06-30
# The Claude runtime needs ANTHROPIC_API_KEY; the server does not start without it. Answers cost money.
# ANTHROPIC_API_KEY=
# Local trials only: use this computer's Claude Code sign-in instead of an API key. The server then listens on
# 127.0.0.1 only and runs one answer at a time. The account's email address reaches the model, and transcripts stay
# in ~/.claude. Anthropic does not allow products to run on a claude.ai sign-in without its approval.
# WORKCELL_CLAUDE_ACCOUNT_LOGIN=1
# Limits per person (defaults shown): answers and cost per UTC day, answers running at once.
# WORKCELL_DAILY_ANSWERS=100
# WORKCELL_DAILY_USD=10
# WORKCELL_CONCURRENT_ANSWERS=2
# WORKCELL_ANSWER_MAX_USD=1.0
# Built files are deleted after this many hours.
# WORKCELL_FILE_KEEP_HOURS=24
# Documents: upload (answer server) and processing (python -m agent_workcell.documents work). Both log in as the
# documents role and share WORKCELL_DATA_DIR. Leave the URL out to turn uploads off.
WORKCELL_DOCUMENTS_DATABASE_URL=postgresql://workcell_documents:workcell_documents_dev@127.0.0.1:54329/erp
# Largest file the server accepts, in bytes (default 100 MB).
# WORKCELL_DOCUMENT_MAX_BYTES=104857600
# Embeddings for document search, read by the worker and by the answer server. Leave the provider out to search by
# words only. fake costs nothing and needs no network. openai and openrouter send passage text to
# that provider and cost money.
# WORKCELL_EMBEDDING_PROVIDER=openrouter
# WORKCELL_EMBEDDING_MODEL=openai/text-embedding-3-small
# WORKCELL_EMBEDDING_DIMENSIONS=1536
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# The reference host application (python -m reference_erp.host_app): sign-in and the chat page. It reads the users
# from ERP_DATABASE_URL and calls the answer server with WORKCELL_HOST_KEY.
WORKCELL_ANSWER_URL=http://127.0.0.1:8080
HOST_APP_SESSION_SECRET=change-me-to-another-long-random-secret
